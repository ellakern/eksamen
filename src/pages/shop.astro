---
import Layout from "../layouts/Layout.astro";
import { createClient } from "@supabase/supabase-js";

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const { data: products, error } = await supabase
  .from("daisy_shop")
  .select("*");

const billeder = [
  "/images/produkt2.JPG",
  "/images/produkt3.JPG",
];

function hentBillede(index: number) {
  return billeder[index % billeder.length];
}
---

<Layout>
  <main class="shop-page">
    <section class="shop-hero">
      <h1>Kunst hos Daisy</h1>

      <nav class="filter-nav">
        <a href="/shop" data-filter-link="alle">Alle</a>
        <a href="/shop?kategori=Vægkunst" data-filter-link="Vægkunst">Vægkunst</a>
        <a href="/shop?kategori=Drikkevarer" data-filter-link="Drikkevarer">Drikkevarer</a>
      </nav>
    </section>

    <section class="products">
      {products?.map((product, index) => (
        <article class="product-card" data-kategori={product.kategori}>
          <img src={hentBillede(index)} alt={product.produkt_navn} />

          <div class="product-info">
            <p>{product.kategori}</p>
            <h2>{product.produkt_navn}</h2>
            <p>{product.pris} kr.</p>
            <p>{product.størrelse}</p>

            <button
              class="read-more"
              data-navn={product.produkt_navn}
              data-kategori={product.kategori}
              data-pris={product.pris}
              data-storrelse={product.størrelse}
              data-beskrivelse={product.produkt_beskrivelse}
              data-billede={hentBillede(index)}
            >
              Læs mere
            </button>
          </div>
        </article>
      ))}
    </section>

    <section class="popup" id="popup">
      <div class="popup-content">
        <button class="close-popup" id="closePopup">×</button>

        <img id="popupBillede" src="" alt="" />

        <div class="popup-text">
          <p id="popupKategori"></p>
          <h2 id="popupNavn"></h2>
          <p id="popupPris"></p>
          <p id="popupStorrelse"></p>
          <p id="popupBeskrivelse"></p>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    // FILTER HIGHLIGHT
    const filterLinks = document.querySelectorAll("[data-filter-link]");
    const currentKategori = new URLSearchParams(window.location.search).get("kategori");

    filterLinks.forEach((link) => {
      const linkKategori = link.getAttribute("data-filter-link");

      if (!currentKategori && linkKategori === "alle") {
        link.classList.add("active");
      }

      if (currentKategori === linkKategori) {
        link.classList.add("active");
      }
    });

    // FILTER CARDS
    const cards = document.querySelectorAll(".product-card");

    if (currentKategori) {
      cards.forEach((card) => {
        if (card.getAttribute("data-kategori") === currentKategori) {
          card.style.display = "flex";
        } else {
          card.style.display = "none";
        }
      });
    }

    // POPUP
    const buttons = document.querySelectorAll(".read-more");
    const popup = document.querySelector("#popup");
    const closePopup = document.querySelector("#closePopup");

    const popupBillede = document.querySelector("#popupBillede");
    const popupKategori = document.querySelector("#popupKategori");
    const popupNavn = document.querySelector("#popupNavn");
    const popupPris = document.querySelector("#popupPris");
    const popupStorrelse = document.querySelector("#popupStorrelse");
    const popupBeskrivelse = document.querySelector("#popupBeskrivelse");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        popupBillede.src = button.getAttribute("data-billede");
        popupBillede.alt = button.getAttribute("data-navn");

        popupKategori.textContent = button.getAttribute("data-kategori");
        popupNavn.textContent = button.getAttribute("data-navn");
        popupPris.textContent = button.getAttribute("data-pris") + " kr.";
        popupStorrelse.textContent = button.getAttribute("data-storrelse");
        popupBeskrivelse.textContent =
          button.getAttribute("data-beskrivelse");

        popup.classList.add("active");
      });
    });

    closePopup.addEventListener("click", () => {
      popup.classList.remove("active");
    });
  </script>
</Layout>

<style>
  .kontakt-section {
  padding: 6rem 2rem;
}

.kontakt-container {
  display: flex;
  justify-content: center;
  gap: 4rem;
}

.kontakt-box {
  border: 20px solid #831515;
  padding: 3rem;
  width: 350px;
  text-align: center;
  background-color: #f5f3dd;
}
.filter-nav {
  display: flex;
  justify-content: center;
  gap: 2rem;
  margin-top: 2rem;
}

.filter-nav a {
  text-decoration: none;
  color: #6b0000;
}
.filter-nav a.active {
  text-decoration: underline;
  font-weight: 700;
}

/* GRID */

.shop-hero {
  padding-top: 5rem;
}
.products {
  display: grid;
  grid-template-columns: repeat(3, 320px);
  justify-content: center;
  gap: 3rem;
  padding: 4rem 2rem 6rem;
}

/* KORT */
.product-card {
  background: #831515;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  min-height: 550px;
}


/* BILLEDE */
.product-card img {
  width: 100%;
  height: 280px;
  object-fit: cover;
  display: block;
}

/* INFO */
.product-info {
  display: flex;
  flex-direction: column;
  padding: 1.8rem 0.8rem 0;
  flex: 1;
  gap: 0.4rem;
}

.product-info p:first-child {
  font-size: 1.6rem;
  color: #f4f7da;
  opacity: 0.85;
}

/* navn */
.product-info h2 {
  font-size: 2rem;
  font-weight: 600;
  color: #f4f7da;
  line-height: 1.1;
}

/* pris */
.product-info p:nth-child(3) {
  font-size: 1.9rem;
  color: #f4f7da;
}

/* størrelse */
.product-info p:nth-child(4) {
  font-size: 1rem;
  color: #f4f7da;
  opacity: 0.7;
  margin-bottom: 2rem;
}

/* KNAP */
.read-more {
  font-family: var(--font-h2);
  font-size: 1.2rem;
  font-weight: 600;
  background: transparent;
  color: #f4f7da;
  border: 1.5px solid #f4f7da;
  margin-top: auto;
  width: 100%;
  align-self: stretch;
}

.read-more:hover {
  background: #f4f0d7;
  color: #7a0000;
}

/* TABLET */
@media (max-width: 1100px) {
  .products {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* MOBIL */
@media (max-width: 700px) {
  .products {
    grid-template-columns: 1fr;
    padding: 2rem;
  }

  .product-card {
    min-height: auto;
  }

  .product-card img {
    height: 240px;
  }
}
/* OVERLAY */
.popup {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(65, 0, 0, 0.82);
  backdrop-filter: blur(6px);
  z-index: 1000;
  padding: 3rem;
}

.popup.active {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* SELVE KORTET */
.popup-content {
  background: #f5f1d8;
  color: #4b0000;
  width: min(1100px, 90vw);
  max-height: 85vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  padding: 2.5rem;
  border-radius: 6px;
  overflow: hidden;
  position: relative;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
}

/* BILLEDE */
.popup-content img {
  width: 100%;
  height: 100%;
  max-height: 650px;
  object-fit: cover;
  border-radius: 4px;
}

/* TEKST SIDE */
.popup-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow-y: auto;
  padding-right: 0.5rem;
}

/* kategori */
#popupKategori {
  font-size: 1rem;
  text-transform: uppercase;
  letter-spacing: 2px;
  opacity: 0.7;
  margin-bottom: 0.8rem;
}

/* navn */
.popup-text h2 {
  font-size: 3.4rem;
  line-height: 1;
  margin-bottom: 1.5rem;
}

/* pris */
#popupPris {
  font-size: 2.4rem;
  margin-bottom: 1rem;
}

/* størrelse */
#popupStorrelse {
  font-size: 1.1rem;
  opacity: 0.8;
  margin-bottom: 2rem;
}

/* beskrivelse */
#popupBeskrivelse {
  font-size: 1.35rem;
  line-height: 1.7;
  max-width: 500px;
}

/* LUK KNAP */
.close-popup {
  position: absolute;
  top: 1.2rem;
  right: 1.2rem;
  width: 42px;
  height: 42px;
  border: none;
  border-radius: 50%;
  background: #8d0000;
  color: #f5f1d8;
  font-size: 1.8rem;
  cursor: pointer;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: 0.2s ease;
}

.close-popup:hover {
  transform: scale(1.08);
  background: #6b0000;
}

/* MOBIL */
@media (max-width: 900px) {
  .popup {
    padding: 1rem;
  }

  .popup-content {
    grid-template-columns: 1fr;
    max-height: 90vh;
    overflow-y: auto;
    gap: 1.5rem;
    padding: 1.5rem;
  }

  .popup-content img {
    max-height: 300px;
  }

  .popup-text h2 {
    font-size: 2.4rem;
  }

  #popupPris {
    font-size: 1.8rem;
  }

  #popupBeskrivelse {
    font-size: 1.1rem;
  }
}
</style>