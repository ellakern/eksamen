---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { Image } from "astro:assets";
import forside from "../assets/forside/forside.webp";
import besøgos from "../assets/forside/besøgos.jpg";
import blomster from "../assets/forside/blomster.svg";
import crazyroom from "../assets/forside/crazyroom.jpg";

---

<Layout>
  <main class="container">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-title">
        <h1>Daisy Kunstbar</h1>
        <p class="hero-undertitel">"Istedgades måske hyggeligste bar"</p>
      </div>
      <div class="hero-content">
    <Image
        src={forside}
        alt="forsidebillede"
        width={800}
        height={600}
        format="webp"
        quality={100}
        sizes="(max-width: 768px) 100vw, 50vw"
      />

        <div class="hero-text">
          <p>
            På Istedgade 44 finder du Daisy Kunstbar - en lille, kreativ oase
            midt i byen. Her mødes kunst, hygge og gode samtaler i varme
            omgivelser, hvor du kan nyde et glas vin, en cocktail eller bare en
            særlig stemning. Daisy er et sted at opleve og blive inspireret.
          </p>
        </div>
      </div>
    </section>

    <!-- BESØG OS -->
    <section class="besøgos">
      <Image
        src={besøgos}
        alt="Interiør og stemning hos Daisy Kunstbar"
        width={800}
        height={600}
        format="webp"
        quality={80}
        sizes="(max-width: 768px) 100vw, 50vw"
      />
      <div class="visit-content">
        <h2>Besøg os</h2>

        <p>
          Daisy Kunstbar er et kreativt og stemningsfuldt samlingspunkt, hvor
          kunst, kultur og fællesskab mødes i øjenhøjde. Her er der plads til
          både fordybelse, inspiration og hyggelige stunder - uanset om du
          kommer for et glas vin, en koncert eller en udstilling.
        </p>

        <p>
          Hos Daisy handler det om atmosfære, kreativitet og nærvær i unikke
          omgivelser midt på Istedgade.
        </p>

        <div class="more-text" id="moreText">
          <p>Se åbningstider på "Om" siden.</p>
        </div>

        <button class="more-btn" id="moreBtn"> Mere + </button>

        <div class="info">
          <p>Istedgade 44, 1650 København</p>
          <p>DaisyKunstbar@live.dk</p>
          <p>+45 10 20 30 40</p>
        </div>
      </div>
    </section>

    <!-- Blomster -->
    <section class="blomster">
<img src={blomster.src} alt="Illustrerede blomster" />
    </section>
    <!-- CRAZY ROOM -->
    <section class="crazy-room">
      <Image
  src={crazyroom}
  alt="Interiør fra Crazy Room hos Daisy Kunstbar"
  width={800}
  height={600}
  format="webp"
  quality={80}
  sizes="(max-width: 768px) 100vw, 50vw"
/>

      <div class="crazy-content">
        <h2>Crazy Room</h2>
        <p>
          Træd ind i Crazy Room - et farverigt og kreativt univers, hvor kunst,
          hygge og energi smelter sammen i en helt særlig atmosfære.
        </p>

        <p>
          Rummet er skabt til gode samtaler, intime arrangementer og kreative
          aftener med venner, musik og inspiration.
        </p>

        <p>
          Her kan du nyde et glas vin, holde fødselsdag, samle mennesker omkring
          kunst og skabe minder i et rum fyldt med personlighed og varme.
        </p>

        <p>
          Crazy Room kan bookes til private events, mindre selskaber og særlige
          oplevelser hos Daisy Kunstbar.
        </p>
      </div>
    </section>
  </main>
  <script>
    const button = document.getElementById("moreBtn");
    const text = document.getElementById("moreText");

    if (button && text) {
      button.addEventListener("click", () => {
        text.classList.toggle("active");

        if (text.classList.contains("active")) {
          button.textContent = "Mindre -";
        } else {
          button.textContent = "Mere +";
        }
      });
    }
  </script>
</Layout>

<!-- CSS -->
<style>
  .main {
    width: min(1100px, 90%);
    margin-inline: auto;
  }

  /* HERO */

  .hero {
    padding-top: 5rem;
  }

  .hero-title h1 {
    font-size: 5rem;
    color: var(--primary);
    line-height: 1;
  }

  .hero-title p {
    font-size: 1.3rem;
    margin-top: 0.5rem;
  }
  .hero-undertitel {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 1rem;

    color: var(--primary);

    font-size: 1.2rem;
  }

  .hero-undertitel::before,
  .hero-undertitel::after {
    content: "";

    width: 220px;
    height: 1px;

    background: rgba(122, 0, 8, 0.4);
  }

  .hero-content {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: 4rem;
    gap: 1rem;
    align-items: center;
    display: grid;
grid-template-columns: 1fr 1fr;

align-items: center;

gap: 5rem;

padding-inline: 4rem;
  }

  .hero-content img {
    width: 100%;
  }

 .hero-text {
  max-width: 500px;

  justify-self: center;

  text-align: center;
}
  .hero-text p {
    font-size: 1.2rem;
    line-height: 1.6;
  }

  /* BESØG OS */

 .besøgos {
  background: var(--primary);

  display: grid;
  grid-template-columns: 0.8fr 1fr;

  gap: 4rem;

  padding: 4rem;

  margin-top: 2rem;
  margin-bottom: 4rem;



  min-height: 650px;

  align-items: center;
}

 .besøgos img {
  width: 100%;
  height: 100%;
  object-fit: cover;

  display: block;
}

  .visit-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 480px;
  }

  .visit-content h2 {
    color: var(--accent);
    font-size: 4rem;
    font-weight: 400;
    margin-bottom: 2rem;
  }

  .visit-content p {
    color: #f3d8dc;

    font-size: 1.1rem;

    line-height: 1.7;
  }

  .more-text {
    max-height: 0;
    overflow: hidden;
    transition: 0.4s ease;
  }

  .more-text.active {
    max-height: 300px;
    margin-bottom: 1rem;
  }

  .more-btn {
    background: none;
    border: none;

    color: var(--accent);

    font-size: 1rem;

    cursor: pointer;

    margin-top: 1rem;
  }

  .info {
    margin-top: 3rem;

    border-top: 1px solid rgba(255, 255, 255, 0.3);

    padding-top: 2rem;
  }
  /*Blomster */
  .blomster {
    display: flex;
    justify-content: center;

    margin-top: 8rem;
    margin-bottom: 8rem;
  }
  .blomster img {
    width: 450px;

    transition: 0.3s ease;
  }

  .blomster img:hover {
    transform: scale(1.08);
  }

  /* CRAZY ROOM */

.crazy-room {
  background: var(--blaa);

  display: grid;
  grid-template-columns: 0.8fr 1fr;

  gap: 4rem;

  padding: 4rem;

  margin-top: 8rem;
  margin-bottom: 4rem;

  margin-right: 6rem;

  min-height: 650px;

  align-items: center;
}

  .crazy-room img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  display: block;
}

  .crazy-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .crazy-content h2 {
    background: var(--accent);

    color: white;
    padding: 0.8rem 4rem 0.8rem 1rem;
    font-size: 2.5rem;
    width: fit-content;

    margin-bottom: 3rem;
  }

  .crazy-content p {
    font-size: 1rem;

    line-height: 1.7;
  }

  /* MOBILE */

  @media (max-width: 900px) {
    .hero-content,
    .besøgos,
    .crazy-room {
      grid-template-columns: 1fr;
    }

    .hero-text {
      padding-top: 0;
    }

    .besøgos,
    .crazy-room {
      padding: 2rem;
    }
  }
</style>
