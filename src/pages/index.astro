---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css"
---

<Layout>

<main class="container">

    <!-- HERO -->
   <section class="hero">
 <div class="hero-title">
      <h1>Daisy Kunstbar</h1>
      <p class="hero-undertitel">
  "Istedgades måske hyggeligste bar"
</p>
   </div>
   <div class="hero-content">
  <img src="/images/forside.svg" alt="forsidebillede">

  <div class="hero-text">
          <p>
        På Istedgade 44 finder du Daisy Kunstbar - en lille,
        kreativ oase midt i byen. Her mødes kunst, hygge og gode
        samtaler i varme omgivelser, hvor du kan nyde
        et glas vin, en cocktail eller bare en særlig
        stemning. Daisy er et sted at opleve og blive inspireret.
          </p>
        </div>

      </div>

    </section>

    <!-- BESØG OS -->
      <section class="besøgos">


<img src="/images/besøgos.jpg" alt="besøgos">
        <div class="visit-content">

        <h2>Besøg os</h2>

        <p>
        Daisy Kunstabar er et stemningsfuldt samlingspunkt
        fyldt med kunst, musik og nærvær. Her er plads til 
        både rolige aftenener, kreative møder og hyggelige 
        stunder med venner. 
        Kig forbi til et glas, en udstilling eller bare for 
        at mærke atmosfæren på Istedgade.
        </p>

       <div class="info">
        <p>Istedgade 44, 1650 København</p>
        <p>DaisyKunstbar@live.dk</p>
        <p>+45 10 20 30 40</p>
      </div>

      </div>

    </section>
  
<!-- Blomster -->
 <section class="blomster">
<img src="/images/blomster.svg" alt="blomster">
 </section>


    <!-- CRAZY ROOM -->
    <section class="crazy-room">
  <img src="/images/crazyroom.jpg" alt="crazyroom">
      <div class="crazy-content">
     <h2>Crazy Room</h2>
           <p>
  Træd ind i Crazy Room - et farverigt og kreativt univers,
  hvor kunst, hygge og energi smelter sammen i en helt særlig atmosfære.
</p>

<p>
  Rummet er skabt til gode samtaler, intime arrangementer
  og kreative aftener med venner, musik og inspiration.
</p>

<p>
  Her kan du nyde et glas vin, holde fødselsdag,
  samle mennesker omkring kunst og skabe minder
  i et rum fyldt med personlighed og varme.
</p>

<p>
  Crazy Room kan bookes til private events,
  mindre selskaber og særlige oplevelser hos Daisy Kunstbar.
</p>

      </div>

    </section>

  </main>

</Layout>

<!-- CSS -->
<style>

.main {
  width: min(1100px, 90%);
  margin-inline: auto;
}

/* HERO */

.hero {
  padding-top: 5rem;
}

.hero-title h1 {
  font-size: 5rem;
  color: var(--primary);
  line-height: 1;
}

.hero-title p {
  font-size: 1.3rem;
  margin-top: 0.5rem;
}
.hero-undertitel {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 1rem;

  color: var(--primary);

  font-size: 1.2rem;
}

.hero-undertitel::before,
.hero-undertitel::after {
  content: "";

  width: 220px;
  height: 1px;

  background: rgba(122, 0, 8, 0.4);
}

.hero-content {
  display: grid;
grid-template-columns: 1.8fr 0.8fr;
margin-top: 4rem;
  gap: 2rem;

  align-items: start;
}

.hero-content img {
  width: 85%;
}

.hero-text {
  padding-top: 8rem;
}

.hero-text p {
  font-size: 1.2rem;
  line-height: 1.6;
}

/* BESØG OS */

.besøgos {
  background: var(--primary);

  display: grid;
  grid-template-columns: 1fr 1fr;

  gap: 4rem;
  min-height: 500px;
padding: 1rem;

  margin-top: 2rem;
}

.besøgos img {
     width: 75%;
}

.visit-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 480px;
}

.visit-content h2 {
  color: var(--accent);
font-size: 4rem;
  font-weight: 400;
  margin-bottom: 2rem;
}

.visit-content p {
  color: #f3d8dc;

  font-size: 1.2rem;

  line-height: 1.7;
}

.info {
  margin-top: 3rem;

  border-top: 1px solid rgba(255,255,255,0.3);

  padding-top: 2rem;
}
/*Blomster */
.blomster {
  display: flex;
  justify-content: center;

  margin-top: 8rem;
  margin-bottom: 8rem;
}
.blomster img {
  width: 450px;

  transition: 0.3s ease;
}

.blomster img:hover {
  transform: scale(1.08);
}


/* CRAZY ROOM */

.crazy-room {
  background: var(--blaa);

  display: grid;
  grid-template-columns: 1fr 1fr;

  gap: 1rem;

  padding: 1rem;

  margin-top: 8rem;

  margin-right: 4rem;
  margin-bottom: 4rem;
}

.crazy-room img {
   width: 75%;
}

.crazy-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.crazy-content h2 {
  background: var(--accent);

  color: white;
  padding: 0.8rem 4rem 0.8rem 1rem;
  font-size: 2.5rem;
  width: fit-content;



   margin-bottom: 3rem;
}

.crazy-content p {
font-size: 1rem;

  line-height: 1.7;
}

/* MOBILE */

@media (max-width: 900px) {

  .hero-content,
  .besøgos,
  .crazy-room {
    grid-template-columns: 1fr;
  }

  .hero-text {
    padding-top: 0;
  }

  .besøgos,
  .crazy-room {
    padding: 2rem;
  }

}
    
</style>