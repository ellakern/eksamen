---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import forside from "../assets/forside/forside.webp";
import tryghed from "../assets/om/tryghed.jpeg";
import samvear from "../assets/om/samvear.jpeg";
import diversitet from "../assets/om/diversitet.jpeg";
---

<Layout>
  <main class="om-page">
    <section class="hero">
      <div class="hero-content">
        <Image src={forside} alt="forsidebillede" />

        <div class="hero-text">
          <h1>OM DAISY</h1>
          <p>
            Daisy Kunstbar er et kreativt og stemningsfuldt samlingspunkt, hvor
            kunst, kultur og fællesskab mødes i øjenhøjde. Her er der plads til
            både fordybelse, inspiration og hyggelige stunder – uanset om du
            kommer for et glas vin, en koncert, en udstilling eller bare den
            særlige atmosfære. Hos Daisy er ingen dage helt ens. Væggene er
            fyldt med skiftende kunstværker, baren byder på nøje udvalgte
            drikkevarer, og rummet danner løbende ramme om kreative events,
            musik og sociale oplevelser. Ambitionen er at skabe et levende og
            inkluderende miljø, hvor lokale kunstnere, kreative sjæle og gæster
            kan mødes og føle sig hjemme. Daisy Kunstbar er mere end bare en bar
            – det er et frirum for kreativitet, nærvær og gode oplevelser midt i
            byen.
          </p>
        </div>
      </div>

      <section class="kearnevaerdier">
        <div class="container">
          <h2>VORES KERNEVÆRDIER</h2>

          <div class="billederaekkeom">
            <!-- CARD 1 -->
            <div class="kearnevaerdi-card">
              <h3>SAMVÆR</h3>

              <p>
                Et levende frirum hvor folk mødes over kunst, musik og gode
                samtaler i varme omgivelser.
              </p>

              <Image src={samvear} alt="billede1om" />
            </div>

            <!-- CARD 2 -->
            <div class="kearnevaerdi-card">
              <h3>TRYGHED</h3>

              <p>
                Hos Daisy skal der være plads til at være sig selv og føle sig
                hjemme – uanset hvem man er.
              </p>

              <Image src={tryghed} alt="billed2om" />
            </div>

            <!-- CARD 3 -->
            <div class="kearnevaerdi-card">
              <h3>DIVERSITET</h3>

              <p>
                Vi hylder forskellighed og skaber rum for kreative sjæle, nye
                perspektiver og fællesskab.
              </p>

              <Image src={diversitet} alt="billede3om" />
            </div>
          </div>
        </div>
      </section>

      <section class="kontakt-section">
        <div class="kontakt-container">
          <!-- BOKS 1 -->
          <div class="kontakt-box">
            <h3>Kontaktinformation</h3>

            <p>TLF +45 10203040</p>
            <p>DaisyKunstbar@live.dk</p>
          </div>

          <!-- BOKS 2 -->
          <div class="kontakt-box">
            <h3>Åbningstider</h3>

            <p>Onsdag - lørdag: 15.00-24.00</p>
            <p>Søndag - tirsdag: lukket</p>
          </div>
        </div>
      </section>
    </section>
  </main>

  <style>
    /* HERO */
    .hero {
      padding: 2rem 2rem 4rem;
    }

    .hero-content {
      max-width: 1300px;
      margin: 0 auto;

      display: grid;
      grid-template-columns: 1fr 1fr;

      align-items: center;
      gap: 3rem;
    }

    /* HØJRE SIDE */
    .hero-text {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      text-align: center;
    }

    /* H1 */
    .hero-content h1 {
      font-size: 5rem;
      color: #6c0b0b;

      margin: 0 0 2rem 0;
      letter-spacing: 2px;
    }

    /* BILLEDE */
    .hero-content img {
      width: 100%;
      max-width: 650px;

      display: block;
      margin: 0 auto;
    }

    /* P-TEXT */
    .hero-content p {
      font-size: 1.2rem;
      line-height: 2;

      max-width: 700px;

      margin: 0;
    }

    /* .kearnevaerdier */
    .kearnevaerdier {
      background-color: #6c0b0b;
      color: #f4f7da;
      padding: 5rem 3rem;
    }

    .container {
      max-width: 1300px;
      margin: 0 auto;
    }

    .kearnevaerdier h2 {
      text-align: center;
      color: #f4f7da;
      font-size: 3rem;
      margin-bottom: 4rem;
      font-weight: 400;
    }

    .billederaekkeom {
      display: flex;
      justify-content: center;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .kearnevaerdi-card {
      width: 320px;
      text-align: center;
    }

    .kearnevaerdi-card h3 {
      font-size: 2rem;
      margin-bottom: 1.5rem;
      font-weight: 400;
    }

    .kearnevaerdi-card p {
      line-height: 1.8;
      margin-bottom: 2rem;
      font-size: 1.2rem;
      color: #f4f7da;
    }

    .kearnevaerdi-card img {
      width: 100%;
      height: 220px;
      object-fit: cover;
    }

    /* kontaktinfo */
    .kontakt-section {
      background-color: #f4f7da;
      padding: 5rem 3rem;
    }

    .kontakt-container {
      max-width: 1200px;
      margin: 0 auto;

      display: flex;
      justify-content: center;
      gap: 5rem;
      flex-wrap: wrap;
    }

    .kontakt-box {
      background-color: #f4f7da;
      border: 22px solid #6c0b0b;

      width: 420px;
      min-height: 220px;

      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;

      text-align: center;
      padding: 2rem;
    }

    .kontakt-box h3 {
      font-size: 2rem;
      margin-bottom: 2rem;
      color: #320404;
    }

    .kontakt-box p {
      font-size: 1.1rem;
      margin: 0.4rem 0;
      font-weight: 600;
    }

    /* MOBIL */
    /* RESPONSIVE */
    @media (max-width: 900px) {
      .hero {
        padding: 2rem 1rem 4rem;
      }

      .hero-content {
        display: flex;
        flex-direction: column;

        align-items: center;
        text-align: center;

        gap: 2rem;
      }

      /* H1 ØVERST */
      .hero-text {
        order: 1;
        width: 100%;
      }
      .hero-content img {
        order: 2;
      }

      .hero-text p {
        order: 3;
      }

      .hero-content h1 {
        font-size: 3rem;
        margin-bottom: 1rem;
      }

      /* BILLEDE I MIDTEN */
      .hero-content img {
        width: 100%;
        max-width: 400px;
        height: auto;

        object-fit: contain;

        margin: 0 auto;
      }

      /* TEKST UNDER BILLEDE */
      .hero-text p {
        max-width: 100%;

        font-size: 1rem;
        line-height: 1.8;

        margin-top: 1rem;
      }

      .hero-text {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* LUFT TIL NÆSTE SECTION */
      .hero {
        margin-bottom: 2rem;
      }
    }
  </style>
</Layout>
