---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import forside from "../assets/om/forside.svg";
import tryghed from "../assets/om/tryghed.jpeg";
import samvear from "../assets/om/samvear.jpeg";
import diversitet from "../assets/om/diversitet.jpeg";
---

<Layout>
  <main class="om-page">
    <section class="hero">
      <div class="hero-content">
        <h1>OM DAISY</h1>
        <img src={forside.src} alt="forsidebillede" />
        <p>
          Daisy Kunstbar er et kreativt og stemningsfuldt samlingspunkt, hvor
          kunst, kultur og fællesskab mødes i øjenhøjde. Her er der plads til
          både fordybelse, inspiration og hyggelige stunder – uanset om du
          kommer for et glas vin, en koncert, en udstilling eller bare den
          særlige atmosfære. Hos Daisy er ingen dage helt ens. Væggene er fyldt
          med skiftende kunstværker, baren byder på nøje udvalgte drikkevarer,
          og rummet danner løbende ramme om kreative events, musik og sociale
          oplevelser. Ambitionen er at skabe et levende og inkluderende miljø,
          hvor lokale kunstnere, kreative sjæle og gæster kan mødes og føle sig
          hjemme. Daisy Kunstbar er mere end bare en bar – det er et frirum for
          kreativitet, nærvær og gode oplevelser midt i byen.
        </p>
      </div>
    </section>

    <section class="kearnevaerdier">
      <div class="container">
        <h2>VORES KERNEVÆRDIER</h2>

        <div class="billederaekkeom">
          <!-- CARD 1 -->
          <div class="kearnevaerdi-card">
            <h3>SAMVÆR</h3>

            <p>
              Et levende frirum hvor folk mødes over kunst, musik og gode
              samtaler i varme omgivelser.
            </p>

            <img src={samvear.src} alt="billede1om" />
          </div>

          <!-- CARD 2 -->
          <div class="kearnevaerdi-card">
            <h3>TRYGHED</h3>

            <p>
              Hos Daisy skal der være plads til at være sig selv og føle sig
              hjemme – uanset hvem man er.
            </p>

            <img src={tryghed.src} alt="billed2om" />
          </div>

          <!-- CARD 3 -->
          <div class="kearnevaerdi-card">
            <h3>DIVERSITET</h3>

            <p>
              Vi hylder forskellighed og skaber rum for kreative sjæle, nye
              perspektiver og fællesskab.
            </p>

            <img src={diversitet.src} alt="billede3om" />
          </div>
        </div>
      </div>
    </section>

    <section class="kontakt-section">
      <div class="kontakt-container">
        <!-- BOKS 1 -->
        <div class="kontakt-box">
          <h3>Kontaktinformation</h3>

          <p>TLF +45 10203040</p>
          <p>DaisyKunstbar@live.dk</p>
        </div>

        <!-- BOKS 2 -->
        <div class="kontakt-box">
          <h3>Åbningstider</h3>

          <p>Onsdag - lørdag: 15.00-24.00</p>
          <p>Søndag - tirsdag: lukket</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* .hero */

  .hero {
    padding: 3rem 3rem 5rem;
  }

  .hero-content {
    max-width: 1300px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: 0.9fr 1fr;
    align-items: center;
    gap: 1rem;
  }

  /****** H1 *******/
  .hero-content h1 {
    grid-column: 2;

    font-size: 5rem;
    color: #6c0b0b;

    margin-bottom: 1rem;
    text-align: center;
    letter-spacing: 2px;
  }

  /***** BILLEDE ******/
  .hero-content img {
    width: 100%;
    max-width: 600px;
    justify-self: center;

    object-fit: contain;
  }

  /* TEKST */
  .hero-content p {
    grid-column: 2;

    font-size: 1.2rem;
    line-height: 2.2;

    text-align: center;

    max-width: 760px;

    margin: 0 auto;
    margin-top: -0.5rem;
  }

  /* .kearnevaerdier */
  .kearnevaerdier {
    background-color: #6c0b0b;
    color: #f4f7da;
    padding: 5rem 3rem;
  }

  .container {
    max-width: 1300px;
    margin: 0 auto;
  }

  .kearnevaerdier h2 {
    text-align: center;
    color: #f4f7da;
    font-size: 3rem;
    margin-bottom: 4rem;
    font-weight: 400;
  }

  .billederaekkeom {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .kearnevaerdi-card {
    width: 320px;
    text-align: center;
  }

  .kearnevaerdi-card h3 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    font-weight: 400;
  }

  .kearnevaerdi-card p {
    line-height: 1.8;
    margin-bottom: 2rem;
    font-size: 1.2rem;
    color: #f4f7da;
  }

  .kearnevaerdi-card img {
    width: 100%;
    height: 220px;
    object-fit: flex;
  }

  /* kontaktinfo */
  .kontakt-section {
    background-color: #f4f7da;
    padding: 5rem 3rem;
  }

  .kontakt-container {
    max-width: 1200px;
    margin: 0 auto;

    display: flex;
    justify-content: center;
    gap: 5rem;
    flex-wrap: wrap;
  }

  .kontakt-box {
    background-color: #f4f7da;
    border: 22px solid #6c0b0b;

    width: 420px;
    min-height: 220px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    text-align: center;
    padding: 2rem;
  }

  .kontakt-box h3 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: #320404;
  }

  .kontakt-box p {
    font-size: 1.1rem;
    margin: 0.4rem 0;
    font-weight: 600;
  }

  /* Mobilsite*/
  @media (max-width: 900px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-content h1 {
      grid-column: auto;
      font-size: 3rem;
    }
    .hero-content img {
      max-width: 350px;
    }

    .hero-content p {
      grid-column: auto;
      margin-top: 0;
    }
  }
</style>
