---
//@ts-nocheck
import Layout from "../layouts/Layout.astro";
import "../styles/global.css"
import CalenderCard from "../components/calenderCard.astro";

/*
FETCH FRA SUPABASE
*/
const url = `${import.meta.env.SUPABASE_URL}/rest/v1/daisy_kalender?select=*`;

const apiKey = import.meta.env.SUPABASE_PUBLISHABLE_KEY;

const options = {
  headers: {
    apikey: apiKey,
  },
};

const data = await fetch(url, options)
  .then((res) => res.json());

console.log(data);

type Event = {
  id: number;
  event_titel: string;
  event_beskrivelse: string;
  event_tid: string;
  event_dato: string;
  maaned: string;
  billede: string;
};

/*
SORTER EVENTS VED DATO + TID
*/
data.sort((a: Event, b: Event) => {

  const dateA = new Date(`${a.event_dato}T${a.event_tid}`);
  const dateB = new Date(`${b.event_dato}T${b.event_tid}`);

  return dateA.getTime() - dateB.getTime();

});

/*
GRUPPER EFTER MÅNED
*/
const groupedEvents = data.reduce(
  (acc: Record<string, Event[]>, event: Event) => {

    const month = new Date(event.event_dato)
      .toLocaleDateString("da-DK", {
        month: "long",
      });

    const capitalizedMonth =
      month.charAt(0).toUpperCase() + month.slice(1);

    if (!acc[capitalizedMonth]) {
      acc[capitalizedMonth] = [];
    }

    acc[capitalizedMonth].push(event);

    return acc;

  },
  {}
);
---

<Layout title="Kalender">
  
  <section class="calendar">

    <h1>Kalender</h1>

    {
      Object.entries(groupedEvents).map(([month, monthEvents]) => (

        <div class="month">

          <!-- MÅNED -->
          <div class="monthTitle">
            <span></span>
            <h2>{month}</h2>
            <span></span>
          </div>

          {
            monthEvents.map((event) => (

              <details class="event">

                <summary>

                  <div class="left">
                    {event.event_titel}
                  </div>

                  <div class="right">

                    <span>
                      {
                        new Date(event.event_dato)
                          .toLocaleDateString("da-DK", {
                            day: "numeric",
                            month: "numeric",
                          })
                      }
                    </span>

                    <span>
                      Kl. {event.event_tid.slice(0,5)}
                    </span>

                  </div>

                </summary>

                <CalenderCard event={event} />

              </details>
            ))
          }

        </div>
      ))
    }

  </section>

</Layout>

<style>

  .calendar {
    width: min(100%, 900px);

    margin-inline: auto;

    padding:
      2rem
      1rem
      4rem;
  }

  h1 {
    margin-bottom: 3rem;
  }

  .month {
    margin-bottom: 3rem;
  }

  .monthTitle {
    display: flex;
    align-items: center;
    gap: 1rem;

    margin-bottom: 2rem;
  }

  .monthTitle span {
    flex: 1;

    height: 1px;

    background: var(--primary);
  }

  .monthTitle h2 {
    color: var(--primary);

    font-size: 2rem;
  }

  .event {
    border-bottom:
      1px solid rgba(0,0,0,0.1);

    padding-block: 1rem;
  }

  summary {
    list-style: none;

    cursor: pointer;

    display: flex;
    justify-content: space-between;
    gap: 1rem;

        transition: 0.3s ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .left {
    font-family: var(--font-p);

    font-size: 1.3rem;

    color: var(--text);
  }

  .right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;

    color: var(--text);

    font-family: var(--font-p);
  }

  .right span:first-child {
    font-size: 1.5rem;
  }

  .right span:last-child {
    font-size: 0.9rem;
  }

  details[open] summary {
    margin-bottom: 1rem;
  }

  /*
  DESKTOP
  */
  @media (min-width: 768px) {

    .calendar {
      padding-inline: 2rem;
    }

    .left {
      font-size: 2rem;
    }

    .right span:first-child {
      font-size: 2rem;
    }

    .monthTitle h2 {
      font-size: 3rem;
    }
  }
</style>