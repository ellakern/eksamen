---
import "../styles/footer.css";
---

<footer class="footer">
  <div class="footer__info">
    <a
      href="https://maps.google.com/?q=Istedgade+44,+1650+København"
      target="_blank"
      rel="noopener noreferrer"
      class="footer__address"
    >
      Istedgade 44, 1650 København
    </a>

    <p class="footer__hours">
      Åbningstider: onsdag til lørdag 15-24
    </p>
  </div>

  <div class="footer__icons">
    <a href="mailto:mail@mail.dk" aria-label="Send mail">
      <img src="/mail-ikon.svg" alt="" />
    </a>

    <a href="tel:+4512345678" aria-label="Ring til os">
      <img src="/telefon-ikon.svg" alt="" />
    </a>

    <a
      href="https://www.instagram.com/daisy_kunstbar/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
    >
      <img src="/instagram-ikon.svg" alt="" />
    </a>

    <a
      href="https://www.facebook.com/profile.php?id=61550694729364"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Facebook"
    >
      <img src="/facebook-ikon.svg" alt="" />
    </a>
  </div>
</footer>